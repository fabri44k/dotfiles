// Place your key bindings in this file to override the defaults
// Vim-related keys that VSCodeVim can't handle (outside the text editor,
// or ctrl keys that need a precise `when`). The rest is in settings.json.
[
    // ======================================================================
    // Sidebar
    // ======================================================================
    {
        "key": "ctrl+e",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.files.action.focusFilesExplorer",
        "when": "editorTextFocus"
    },

    // ======================================================================
    // Window navigation (nvim <C-hjkl>)
    // ======================================================================
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft",
        "when": "editorTextFocus && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight",
        "when": "editorTextFocus && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown",
        "when": "editorTextFocus && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp",
        "when": "editorTextFocus && vim.mode != 'Insert'"
    },
    // Also from the sidebar, otherwise ctrl+j toggles the panel (terminal)
    // and ctrl+h opens find/replace in the editor
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight",
        "when": "sideBarFocus && !inputFocus"
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft",
        "when": "sideBarFocus && !inputFocus"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown",
        "when": "sideBarFocus && !inputFocus"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp",
        "when": "panelFocus && !terminalFocus && !inputFocus"
    },

    // ======================================================================
    // Buffers (nvim <Tab> / <S-Tab>)
    // ======================================================================
    {
        "key": "tab",
        "command": "workbench.action.nextEditorInGroup",
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "shift+tab",
        "command": "workbench.action.previousEditorInGroup",
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },

    // ======================================================================
    // Sessions (nvim <C-A-r> AutoSession search)
    // ======================================================================
    {
        "key": "ctrl+alt+r",
        "command": "workbench.action.openRecent"
    },

    // ======================================================================
    // File explorer (neo-tree)
    // ======================================================================
    {
        "key": "\\",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "j",
        "command": "list.focusDown",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "k",
        "command": "list.focusUp",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "l",
        "command": "list.select",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "h",
        "command": "list.collapse",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+a",
        "command": "explorer.newFolder",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "y",
        "command": "filesExplorer.copy",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "x",
        "command": "filesExplorer.cut",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "p",
        "command": "filesExplorer.paste",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "s",
        "command": "explorer.openToSide",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "z",
        "command": "workbench.files.action.collapseExplorerFolders",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+r",
        "command": "workbench.files.action.refreshFilesExplorer",
        "when": "filesExplorerFocus && !inputFocus"
    },

    // ======================================================================
    // Outline (outline.nvim) — opened with <leader>o from the editor
    // ======================================================================
    {
        "key": "q",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "escape",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "j",
        "command": "list.focusDown",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "k",
        "command": "list.focusUp",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "h",
        "command": "list.collapse",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "l",
        "command": "list.expand",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "o",
        "command": "list.selectAndPreserveFocus",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "shift+w",
        "command": "outline.collapse",
        "when": "focusedView == 'outline' && !inputFocus"
    },
    {
        "key": "shift+e",
        "command": "outline.expand",
        "when": "focusedView == 'outline' && !inputFocus"
    }
]
